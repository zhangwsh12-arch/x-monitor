<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>X 账号动态看板</title>
<style>
  :root{
    --bg:#f7f8fa; --card:#ffffff; --border:#e6e8eb; --text:#1f2329;
    --muted:#8a9099; --accent:#1d9bf0; --post:#1d9bf0; --retweet:#00ba7c;
    --quote:#7856ff; --reply:#8a9099; --shadow:0 1px 3px rgba(0,0,0,.06);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    background:var(--bg);color:var(--text);line-height:1.6;padding:24px 16px}
  .wrap{max-width:820px;margin:0 auto}
  header{margin-bottom:20px}
  h1{font-size:22px;font-weight:700;display:flex;align-items:center;gap:8px}
  .date{color:var(--muted);font-size:14px;margin-top:4px}
  .nav{margin:14px 0 26px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .nav-btn{font-size:14px;color:var(--accent);text-decoration:none;padding:6px 14px;
    background:var(--card);border:1px solid var(--border);border-radius:8px;
    display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
  .nav-btn.disabled{color:#c4c9cf;pointer-events:none;background:#f2f3f5}
  .nav select{font-size:14px;color:var(--text);padding:6px 10px;border:1px solid var(--border);
    border-radius:8px;background:var(--card);cursor:pointer;max-width:200px}
  .nav-label{font-size:12px;color:var(--muted);margin-right:2px}
  .acct{background:var(--card);border:1px solid var(--border);border-radius:14px;
    padding:18px 20px;margin-bottom:18px;box-shadow:var(--shadow)}
  .acct-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;
    flex-wrap:wrap;border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:12px}
  .acct-name{font-size:17px;font-weight:700}
  .acct-handle{color:var(--muted);font-size:13px;font-weight:400;margin-left:6px}
  .counts{font-size:12px;color:var(--muted)}
  .topic{background:#f0f7ff;border-left:3px solid var(--accent);padding:8px 12px;
    border-radius:6px;font-size:14px;margin-bottom:14px;color:#1a5fa8}
  .empty{color:var(--muted);font-size:14px;padding:6px 0}
  .item{padding:12px 0;border-bottom:1px dashed var(--border)}
  .item:last-child{border-bottom:none}
  .badge{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;
    border-radius:10px;color:#fff;margin-right:8px;vertical-align:middle}
  .b-post{background:var(--post)} .b-retweet{background:var(--retweet)}
  .b-quote{background:var(--quote)} .b-reply{background:var(--reply)}
  .text{font-size:15px;white-space:pre-wrap;word-break:break-word;margin:4px 0}
  .text-zh{font-size:14px;color:#3a4048;background:#fafbfc;border-radius:6px;
    padding:6px 10px;margin:6px 0}
  .src{font-size:13px;color:var(--muted);border-left:2px solid var(--border);
    padding-left:10px;margin:6px 0}
  .meta{font-size:12px;color:var(--muted);margin-top:6px}
  .meta a{color:var(--accent);text-decoration:none}
  footer{text-align:center;color:var(--muted);font-size:12px;margin-top:24px}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>📡 X 账号动态看板</h1>
    <div class="date">日报 · {{ date }}（KST）· 过去 24 小时</div>
  </header>

  <nav class="nav">
    {% if prev_date %}<a class="nav-btn" href="daily-{{ prev_date }}.html">← 前一天</a>
    {% else %}<span class="nav-btn disabled">← 前一天</span>{% endif %}

    <span class="nav-label">日期</span>
    <select onchange="if(this.value)location.href='daily-'+this.value+'.html'">
      {% for d in all_dates %}
      <option value="{{ d }}" {% if d == date %}selected{% endif %}>{{ d }}</option>
      {% endfor %}
    </select>

    {% if next_date %}<a class="nav-btn" href="daily-{{ next_date }}.html">后一天 →</a>
    {% else %}<span class="nav-btn disabled">后一天 →</span>{% endif %}

    {% if weeks %}
    <span class="nav-label">周报</span>
    <select onchange="if(this.value)location.href='weekly-'+this.value+'.html'">
      <option value="">选择周报…</option>
      {% for w in weeks %}<option value="{{ w }}">{{ w }}</option>{% endfor %}
    </select>
    {% endif %}
  </nav>

  {% for acc in accounts %}
  <section class="acct">
    <div class="acct-head">
      <div class="acct-name">{{ acc.name }}<span class="acct-handle">@{{ acc.handle }}</span></div>
      <div class="counts">原创 {{ acc.counts.post }} · 转发 {{ acc.counts.retweet }} · 引用 {{ acc.counts.quote }}</div>
    </div>
    {% if acc.topic %}<div class="topic">💡 {{ acc.topic }}</div>{% endif %}
    {% if not acc["items"] %}
      <div class="empty">今日无新增内容。</div>
    {% else %}
      {% for it in acc["items"] %}
      <div class="item">
        <span class="badge b-{{ it.kind }}">{{ kind_label(it.kind) }}</span>
        <span class="text">{{ it.text }}</span>
        {% if it.text_zh %}<div class="text-zh">🇨🇳 {{ it.text_zh }}</div>{% endif %}
        {% if it.source_tweet %}
        <div class="src">↳ @{{ it.source_tweet.handle }}：{{ it.source_tweet.text }}</div>
        {% endif %}
        <div class="meta">
          👍 {{ it.metrics.like }} · 🔁 {{ it.metrics.retweet }} · 💬 {{ it.metrics.reply }} · 👁 {{ it.metrics.view }}
          {% if it.url %} · <a href="{{ it.url }}" target="_blank">查看原文 ↗</a>{% endif %}
        </div>
      </div>
      {% endfor %}
    {% endif %}
  </section>
  {% endfor %}

  <footer>自动生成 · 数据来源 TwitterAPI.io · {{ generated_at }}</footer>
</div>
</body>
</html>
